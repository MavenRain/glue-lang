-- M4 s5: Direction 4 of design/DESIGN.md (lines 118-196). OTPSpec is the
-- specification HIT of domain/domain.lang: the points message and cipher
-- and the path constructor encrypt (the law). interp is the non-dependent
-- fold (D6) into an implementation type Impl with the points m and c and
-- the path enc. The design postulates Impl, m, c and enc, so here they are
-- arguments. A .lang file has no import, so the defs from fill0 to
-- isoToEquiv are a copy of examples/iso.lang.

-- fill0 i j: the filler of the square from g (p0 @ ~i) to x0 and g y.
def fill0 : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (t : (x : A) -> Path A (g (f x)) x) -> (y : B) -> (x0 : A) -> (p0 : Path B (f x0) y) -> (i : I) -> (j : I) -> A := fun A => fun B => fun f => fun g => fun t => fun y => fun x0 => fun p0 => fun i => fun j => hcomp A (i \/ ~i \/ ~j) (fun k => [ i -> t x0 @ (j /\ k), ~i -> g y, ~j -> g (p0 @ ~i) ]) (g (p0 @ ~i))

-- fill2 i j: the filler between the two fill0 lids. fill2 i i1 is the path from x0 to x1.
def fill2 : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (t : (x : A) -> Path A (g (f x)) x) -> (y : B) -> (x0 : A) -> (x1 : A) -> (p0 : Path B (f x0) y) -> (p1 : Path B (f x1) y) -> (i : I) -> (j : I) -> A := fun A => fun B => fun f => fun g => fun t => fun y => fun x0 => fun x1 => fun p0 => fun p1 => fun i => fun j => hcomp A (i \/ ~i \/ ~j) (fun k => [ i -> fill0 A B f g t y x1 p1 (j /\ k) i1, ~i -> fill0 A B f g t y x0 p0 (j /\ k) i1, ~j -> g y ]) (g y)

-- sq i j: the square in A over the path fill2 i i1.
def sq : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (t : (x : A) -> Path A (g (f x)) x) -> (y : B) -> (x0 : A) -> (x1 : A) -> (p0 : Path B (f x0) y) -> (p1 : Path B (f x1) y) -> (i : I) -> (j : I) -> A := fun A => fun B => fun f => fun g => fun t => fun y => fun x0 => fun x1 => fun p0 => fun p1 => fun i => fun j => hcomp A (i \/ ~i \/ j \/ ~j) (fun k => [ i -> fill0 A B f g t y x1 p1 j ~k, ~i -> fill0 A B f g t y x0 p0 j ~k, j -> t (fill2 A B f g t y x0 x1 p0 p1 i i1) @ ~k, ~j -> g y ]) (fill2 A B f g t y x0 x1 p0 p1 i j)

-- sq1 i j: the square in B. sq1 i (~j) is the path part of the fiber path.
def sq1 : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (s : (y : B) -> Path B (f (g y)) y) -> (t : (x : A) -> Path A (g (f x)) x) -> (y : B) -> (x0 : A) -> (x1 : A) -> (p0 : Path B (f x0) y) -> (p1 : Path B (f x1) y) -> (i : I) -> (j : I) -> B := fun A => fun B => fun f => fun g => fun s => fun t => fun y => fun x0 => fun x1 => fun p0 => fun p1 => fun i => fun j => hcomp B (i \/ ~i \/ j \/ ~j) (fun k => [ i -> s (p1 @ ~j) @ k, ~i -> s (p0 @ ~j) @ k, j -> s (f (fill2 A B f g t y x0 x1 p0 p1 i i1)) @ k, ~j -> s y @ k ]) (f (sq A B f g t y x0 x1 p0 p1 i j))

-- lemIso: two points of a fiber of f are equal.
def lemIso : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (s : (y : B) -> Path B (f (g y)) y) -> (t : (x : A) -> Path A (g (f x)) x) -> (y : B) -> (x0 : A) -> (x1 : A) -> (p0 : Path B (f x0) y) -> (p1 : Path B (f x1) y) -> Path (fiber f y) (pack x0 p0) (pack x1 p1) := fun A => fun B => fun f => fun g => fun s => fun t => fun y => fun x0 => fun x1 => fun p0 => fun p1 => <i> pack (fill2 A B f g t y x0 x1 p0 p1 i i1) (<j> sq1 A B f g s t y x0 x1 p0 p1 i ~j)

-- isoToEquiv: the center of the fiber over y is g y with s y.
def isoToEquiv : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (s : (y : B) -> Path B (f (g y)) y) -> (t : (x : A) -> Path A (g (f x)) x) -> Equiv A B := fun A => fun B => fun f => fun g => fun s => fun t => pack f (fun y => pack (pack (g y) (s y)) (fun z => lemIso A B f g s t y (g y) (witness z) (s y) (payload z)))

-- interp message = m, interp cipher = c, interp (encrypt @ i) = enc @ i
-- (DESIGN line 141), and interp commutes with hcomp (the s3 rule).
def interp : (Impl : Type 0) -> (m : Impl) -> (c : Impl) -> (enc : Path Impl m c) -> OTPSpec -> Impl := fun Impl => fun m => fun c => fun enc => fun x => fold Impl m c enc x
def interpMessage : (Impl : Type 0) -> (m : Impl) -> (c : Impl) -> (enc : Path Impl m c) -> Path Impl (interp Impl m c enc message) m := fun Impl => fun m => fun c => fun enc => refl
def interpCipher : (Impl : Type 0) -> (m : Impl) -> (c : Impl) -> (enc : Path Impl m c) -> Path Impl (interp Impl m c enc cipher) c := fun Impl => fun m => fun c => fun enc => refl
def interpEncrypt : (Impl : Type 0) -> (m : Impl) -> (c : Impl) -> (enc : Path Impl m c) -> Path (Path Impl m c) (<i> interp Impl m c enc (encrypt @ i)) enc := fun Impl => fun m => fun c => fun enc => refl
def interpHcomp : (Impl : Type 0) -> (m : Impl) -> (c : Impl) -> (enc : Path Impl m c) -> (k : I) -> Path Impl (interp Impl m c enc (hcomp OTPSpec k (fun i => [ k -> encrypt @ i ]) message)) (hcomp Impl k (fun i => [ k -> interp Impl m c enc (encrypt @ i) ]) m) := fun Impl => fun m => fun c => fun enc => fun k => refl

-- An implementation in Field. A path between two distinct numerals does
-- not exist, so m = c = 7 and enc = refl.
def interpField : OTPSpec -> Field := fun x => interp Field 7 7 refl x
def fieldMessage : Field := interpField message
def fieldEncrypt : Path Field 7 7 := <i> interpField (encrypt @ i)

-- specImpl through isoToEquiv, a function of the iso (DESIGN line 152; a
-- closed Equiv holds a function and has no JSON form). OTPSpec is the
-- walking interval. An inverse into a type other than OTPSpec needs the
-- retraction (x : OTPSpec) -> Path OTPSpec (g (f x)) x for a variable x,
-- and the non-dependent fold cannot give it (D6 of M4; the dependent
-- eliminator elim of M5 gives it, see ret below). So the
-- rows below use the identity iso of OTPSpec, and
-- interp OTPSpec message cipher encrypt is the fold that agrees with it.
def specImpl : (Impl : Type 0) -> (f : OTPSpec -> Impl) -> (g : Impl -> OTPSpec) -> (s : (y : Impl) -> Path Impl (f (g y)) y) -> (t : (x : OTPSpec) -> Path OTPSpec (g (f x)) x) -> Equiv OTPSpec Impl := fun Impl => fun f => fun g => fun s => fun t => isoToEquiv OTPSpec Impl f g s t
def specPath : (Impl : Type 0) -> (f : OTPSpec -> Impl) -> (g : Impl -> OTPSpec) -> (s : (y : Impl) -> Path Impl (f (g y)) y) -> (t : (x : OTPSpec) -> Path OTPSpec (g (f x)) x) -> Path (Type 0) OTPSpec Impl := fun Impl => fun f => fun g => fun s => fun t => ua (specImpl Impl f g s t)
def otpId : OTPSpec -> OTPSpec := fun x => x
def idSect : (y : OTPSpec) -> Path OTPSpec (otpId (otpId y)) y := fun y => refl

-- transport along ua (specImpl ...) is the function of the iso (D8 of M3,
-- DESIGN lines 154-169), so transport (ua specImpl) message = interp message.
def transportMessage : Path OTPSpec (transport (ua (specImpl OTPSpec otpId otpId idSect idSect)) message) (interp OTPSpec message cipher encrypt message) := refl
def transportCipher : Path OTPSpec (transport (specPath OTPSpec otpId otpId idSect idSect) cipher) (interp OTPSpec message cipher encrypt cipher) := refl
def specMessage : OTPSpec := transport (ua (specImpl OTPSpec otpId otpId idSect idSect)) message

-- The transport of the law: encrypt moved along ua specImpl is encrypt.
def lawAt : (j : I) -> OTPSpec := fun j => transport (ua (specImpl OTPSpec otpId otpId idSect idSect)) (encrypt @ j)
def lawImpl : Path (Path OTPSpec message cipher) (<j> lawAt j) encrypt := refl

-- M5 s2: flip swaps message and cipher and reverses encrypt. ret is the
-- retraction of flip by the dependent eliminator elim. The case of encrypt
-- is a square: flip (flip (encrypt @ i)) = encrypt @ ~~i = encrypt @ i.
-- isoToEquiv OTPSpec OTPSpec flip flip ret ret is an iso of OTPSpec that is
-- not the identity, so transport along its ua moves message to cipher and
-- reverses encrypt. A closed Equiv holds a function and has no JSON form, so
-- flipPath holds the ua path (a path is not an instance).
def flip : OTPSpec -> OTPSpec := fun x => fold OTPSpec cipher message (<i> encrypt @ ~i) x
def ret : (x : OTPSpec) -> Path OTPSpec (flip (flip x)) x := fun x => elim (fun y => Path OTPSpec (flip (flip y)) y) refl refl (<i> <j> encrypt @ i) x
def flipPath : Path (Type 0) OTPSpec OTPSpec := ua (isoToEquiv OTPSpec OTPSpec flip flip ret ret)
def flipMessage : Path OTPSpec (transport flipPath message) cipher := refl
def flipLaw : Path OTPSpec cipher message := <i> transport flipPath (encrypt @ i)
