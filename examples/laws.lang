-- Laws that the checker proves by normalization: each proof is refl.
def xs : List Nat := cons 1 (cons 2 nil)
def noNats : List Nat := nil
def leftFour : Sum Nat Nat := inl 4
def beta : Path Nat ((fun (n : Nat) => natMul n n) 6) 36 := refl
def eta : Path ((n : Nat) -> Nat) (fun (n : Nat) => natAdd n 1) (fun (m : Nat) => natAdd m 1) := refl
def mapId : Path (List Nat) (map (fun (n : Nat) => n) xs) xs := refl
def leftUnit : Path (Option Nat) (bind (pure 4) (fun (n : Nat) => some (natAdd n 1))) (some 5) := refl
def rightUnit : Path (Option Nat) (bind (some 4) (fun (n : Nat) => pure n)) (some 4) := refl
def foldNil : Path Nat (fold (fun (x : Nat) (acc : Nat) => natAdd x acc) 0 noNats) 0 := refl
def foldSum : Path Nat (fold (fun (x : Nat) (acc : Nat) => natAdd x acc) 0 xs) 3 := refl
def firstPair : Path Nat (first (pair 3 flagYes)) 3 := refl
def eitherLeft : Path Nat (either (fun (n : Nat) => n) (fun (n : Nat) => natAdd n 1) leftFour) 4 := refl
def subFloor : Path Nat (natSub 3 5) 0 := refl
def flagTrue : Path Nat (flagIf (natLe 2 3) 1 0) 1 := refl
def lotLaw : Path Nat (lotPrice (makeLot 3 250)) 250 := refl
def productEta : (p : Prod Nat Nat) -> Path (Prod Nat Nat) (pair (first p) (second p)) p := fun p => refl
def sigmaEta : (s : Sigma (n : Nat) (Path Nat n n)) -> Path (Sigma (n : Nat) (Path Nat n n)) (pack (witness s) (payload s)) s := fun s => refl
