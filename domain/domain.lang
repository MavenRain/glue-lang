-- Sample domain. Replace it with your design. See domain/README.md.
-- Each family, constructor, field and def name here becomes a core name
-- (rule R4). Only this file can declare a family (rule R1).
family Color := red | green | blue
family Item := makeItem (itemColor : Color) (itemPrice : Nat) (itemCount : Nat)
family Stack := bottom | push (top : Nat) (rest : Stack)
-- An indexed family (former F15): `Lot 3` is a lot of size 3.
family Lot (size : Nat) := makeLot (lotPrice : Nat)

def lineTotal : (item : Item) -> Nat :=
  fun (item : Item) => natMul (itemPrice item) (itemCount item)
def isRed : (color : Color) -> Flag :=
  fun (color : Color) => fold flagYes flagNo flagNo color
def total : (items : List Item) -> Nat :=
  fun (items : List Item) => fold (fun (item : Item) (acc : Nat) => natAdd (lineTotal item) acc) 0 items
def redTotal : (items : List Item) -> Nat :=
  fun (items : List Item) => total (filter (fun (item : Item) => isRed (itemColor item)) items)
def depth : (s : Stack) -> Nat :=
  fun (s : Stack) => fold 0 (fun (top : Nat) (rest : Nat) => natAdd rest 1) s
-- M4 s1: higher inductive types. A path constructor binds interval names
-- and gives its boundary system. A constructor takes the family parameters.
family Circle := base | loop <i> [ ~i -> base, i -> base ]
family Susp (A : Type 0) := north | south | merid (apex : A) <i> [ ~i -> north A, i -> south A ]
-- M4 s3: the propositional truncation (D10).
family Trunc (A : Type 0) := inc (held : A) | squash (lo : Trunc A) (hi : Trunc A) <i> [ ~i -> lo, i -> hi ]
family Quot (A : Type 0) (R : A -> A -> Type 0) := cls (cla : A) | eqc (eqa : A) (eqb : A) (eqr : R eqa eqb) <i> [ ~i -> cls A R eqa, i -> cls A R eqb ] | squashc (sqx : Quot A R) (sqy : Quot A R) (sqp : Path (Quot A R) sqx sqy) (sqq : Path (Quot A R) sqx sqy) <i j> [ ~i -> sqp @ j, i -> sqq @ j, ~j -> sqx, j -> sqy ]
-- M4 s5: the Direction 4 specification (design/DESIGN.md): two points and
-- the path constructor encrypt, the law "encryption produces a cipher".
family OTPSpec := message | cipher | encrypt <i> [ ~i -> message, i -> cipher ]
-- M4 s5: the graph quotient, Quot without the set truncation squashc. A
-- fold out of it needs no isSet case (examples/quotSq.glue, M4-PLAN section 6).
family GQuot (A : Type 0) (R : A -> A -> Type 0) := gcls (gcla : A) | geqc (geqa : A) (geqb : A) (geqr : R geqa geqb) <i> [ ~i -> gcls A R geqa, i -> gcls A R geqb ]
-- M5 s1: two quotient inductive types (M5-PLAN D1, D2). A path constructor
-- is an equation: its ends are point terms. The ends of bswap hold the
-- recursive field sxs under two constructors.
family Bag (A : Type 0) := bnil | bcons (bx : A) (bxs : Bag A) | bswap (sx : A) (sy : A) (sxs : Bag A) <i> [ ~i -> bcons A sx (bcons A sy sxs), i -> bcons A sy (bcons A sx sxs) ]
family Int := pos (pn : Nat) | neg (nn : Nat) | zeq <i> [ ~i -> pos 0, i -> neg 0 ]
-- M5 s3 (D5): a field that uses an earlier field (hcomp, the comp method) and a point constructor with a path field (transp).
family DPair (A : Type 0) (B : A -> Type 0) := dpair (dfst : A) (dsnd : B dfst)
family Web (A : Type 0) := wnode (wn : A) | wlink (wlx : Web A) (wly : Web A) (wlp : Path (Web A) wlx wly) | wloop (wa : A) <i> [ ~i -> wnode A wa, i -> wnode A wa ]
-- M5 s4 (D6): an inductive-inductive block. Ty is indexed by Ctx, and the
-- field et of ext has the type Ty at the earlier field eg (a partner field).
mutual family Ctx := cempty | ext (eg : Ctx) (et : Ty eg)
family Ty (tg : Ctx) := tbase | arrow (ta : Ty tg) (tb : Ty tg)
